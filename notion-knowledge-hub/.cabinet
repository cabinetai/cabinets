schemaVersion: 1
id: notion-knowledge-hub-root
name: Knowledge Hub
kind: root
version: 0.1.0
description: Your Notion wiki, kept fresh. What changed, what went stale, which links broke, and an assistant who answers from your pages.
entry: index.md
domain: Operations
app: wiki

connectors:
  - id: notion
    need: needs
    access: [read]
    why: Reads the Notion pages you picked to keep your wiki fresh and answer from it.
    usedBy: [jobs/morning-knowledge]
    hero: true

prompts:
  - text: What changed in our Notion this week?
    connector: notion
  - text: Which pages need a review?
    connector: notion
  - text: Find the page about our onboarding
    connector: notion
  - text: Summarize our product principles page
    connector: notion
  - text: Which links in our wiki are broken?
    connector: notion
  - text: Who keeps our wiki up to date?
    connector: notion
  - text: Draft an FAQ from our help pages
    connector: notion
  - text: What questions does our wiki not answer yet?
    connector: notion
