schemaVersion: 1
id: google-drive-team-drive-root
name: Team Drive
kind: root
version: 0.1.0
description: Your shared Drive folder, able to say what changed this week and where the current version is.
entry: index.md
domain: Operations
connectors:
  - id: google-drive
    need: needs
    access:
      - read
    why: Reads the shared folder so your team can say what changed and where things are.
    usedBy:
      - jobs/monday-drive-brief
      - jobs/monthly-drive-map
    hero: true
prompts:
  - text: What changed in the drive this week?
    connector: google-drive
  - text: Where is the latest version of the contract?
    connector: google-drive
  - text: Who touched the pricing deck last?
    connector: google-drive
  - text: Is there more than one copy of the brand guidelines?
    connector: google-drive
  - text: What is in the Finance folder?
    connector: google-drive
  - text: Find everything about the Northwind account.
    connector: google-drive
  - text: Which files has nobody opened in a year?
    connector: google-drive
  - text: What did we agree in the last board pack?
    connector: google-drive
