schemaVersion: 1
id: gmail-finance-root
name: Gmail for Finance
kind: root
version: 0.1.0
description: The money in your business inbox. Invoices not paid yet, payments that came in, bills to pay, and receipts for your accountant.
entry: index.md
domain: Operations
app: money-desk

connectors:
  - id: gmail
    need: needs
    access: [read, send]
    why: Reads your email each morning to find money in and out. Nothing is sent without your OK.

prompts:
  - text: "Who owes me money?"
    connector: gmail
  - text: "Which invoices are overdue?"
    connector: gmail
  - text: "What bills are due this week?"
    connector: gmail
  - text: "Did any payment fail?"
    connector: gmail
  - text: "What came in this week?"
    connector: gmail
  - text: "Anything from the bank?"
    connector: gmail
  - text: "Find this month's receipts for my accountant"
    connector: gmail
  - text: "Which customers pay late?"
    connector: gmail
  - text: "Draft reminders for every overdue invoice"
    connector: gmail
  - text: "Write this week's money summary for my partner"
    connector: gmail
