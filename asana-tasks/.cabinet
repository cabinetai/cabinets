schemaVersion: 1
id: asana-tasks-root
name: Asana Tasks
kind: root
version: 0.1.1
description: Every morning, the Asana tasks that are actually on you today.
entry: index.md
domain: Operations
connectors:
  - id: asana
    need: needs
    access: [read]
    why: Reads the open tasks assigned to you.
    hero: true
prompts:
  - text: Which of my tasks are due today?
    connector: asana
  - text: Is anyone blocked waiting on me in Asana?
    connector: asana
  - text: What's overdue on my list?
    connector: asana
  - text: What are my tasks for this week?
    connector: asana
  - text: Which of my tasks have no due date?
    connector: asana
