schemaVersion: 1
id: x-mentions-root
name: X Mentions
kind: root
version: 0.1.1
description: Every morning, your mentions and which of them actually want an answer.
entry: index.md
domain: Operations
connectors:
  - id: x
    need: needs
    access: [read]
    why: Reads the posts that mention, reply to or quote you.
    hero: true
prompts:
  - text: Who mentioned me yesterday?
    connector: x
  - text: Which replies actually want an answer?
    connector: x
  - text: Did anyone quote my last post?
    connector: x
  - text: Is anyone asking me a question on X today?
    connector: x
