schemaVersion: 1
id: x-mentions-root
name: X Digest
kind: root
version: 0.2.0
description: X tells you about every like, follow and bot. This shows the people who wrote to you and want an answer, with a reply ready to post.
entry: index.md
domain: Operations
app: catch-up
connectors:
  - id: x
    need: needs
    access: [read]
    why: Reads the posts that mention, reply to or quote you. Nothing is posted.
    hero: true
prompts:
  - text: Who on X is waiting for an answer from me?
    connector: x
  - text: Write a reply to everyone who asked me something on X
    connector: x
  - text: Did anyone quote my last post?
    connector: x
  - text: Who talks to me most on X?
    connector: x
  - text: Which questions on X did I never answer this week?
    connector: x
  - text: What did people say about my newest post?
    connector: x
