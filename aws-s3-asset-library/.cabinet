schemaVersion: 1
id: aws-s3-asset-library-root
name: Asset Library
kind: root
version: 0.1.0
description: Everything your agency has delivered, what landed this week, and what nobody has cleared to use.
entry: index.md
domain: Media
connectors:
  - id: aws-s3
    need: needs
    access:
      - read
    why: Reads the finished work your agency drops into the bucket.
    usedBy:
      - jobs/monday-asset-catalogue
prompts:
  - text: What landed this week?
    connector: aws-s3
  - text: Which assets have no usage note?
    connector: aws-s3
  - text: Is there a vertical cut of the autumn film?
    connector: aws-s3
  - text: What am I still allowed to run in December?
    connector: aws-s3
  - text: Show me everything for the Harvest campaign.
    connector: aws-s3
  - text: Is there a newer version of the hero image?
    connector: aws-s3
  - text: What did the agency deliver last month?
    connector: aws-s3
  - text: Did they ever send the logo on a dark background?
    connector: aws-s3
