.DS_Store

# Runtime artifacts (generated by cabinet agents at runtime)
.agents/.conversations/
.agents/.memory/
.agents/.messages/
**/.agents/.conversations/
**/.agents/.memory/
**/.agents/.messages/

# Local docs, planning, and tooling — not for public registry
/cabinets-docs/
.github/scripts/node_modules/

# Local cabinet-manager metadata
.cabinet-meta
.repo.yaml

# Temp / leftover files
**/cover.jpg.tmp
**/*.tmp
**/__pycache__/

# Finder leftovers
**/New Folder With Items/

# Per-cabinet runtime analytics output (not template content)
**/analytics/pattern-analysis-*.md

# Runtime analytics and pipeline outputs (per-cabinet, not templates)
**/analytics/pipeline-health-*.md
**/analytics/rejection-pattern-analysis-*.md
**/pipeline/scan-digest-*.md
**/cv-lab/audit-*.md

# Per-cabinet local cabinet-manager metadata
**/.cabinet-meta
**/.repo.yaml

# Pipeline tracker uses real data — must be local-only
**/pipeline/tracker.csv

# Runtime dashboard snapshots
**/analytics/dashboard-context.md

# Cabinet-instance runtime files (research, tailored CVs, dated outreach, etc.)
**/cv-lab/cv-*.md
**/evaluations/research-*.md
**/evaluations/pipeline-*-*.md
**/evaluations/*-2026-*.md
**/interview-prep/*-prep.md
**/interview-prep/*-debrief.md
**/interview-prep/*-negotiation.md
**/outreach/cadence-*.md
**/outreach/follow-up-*.md

# Music-factory test artifacts
music-factory/still-alive-v2/


# Secrets — never in a public template repo
.env
.env.*
**/.env
**/.env.*
**/.cabinet.env

# Agent transcripts. These capture raw shell output, so they carry local
# filesystem paths and whatever the agent read. Public repo — keep them local.
**/.agents/.history/

# Per-cabinet runtime state (file history, indexes) — machine-specific
**/.cabinet-state/

# gmail-inbox summarises real mail. Only the EXAMPLE file is template content:
# it is what the page shows a new user before their first run.
gmail-inbox/daily-summaries/*
!gmail-inbox/daily-summaries/EXAMPLE-*.md
gmail-inbox/subscriptions.md

# More agent runtime siblings of the .conversations/.memory/.messages above
**/.agents/skills-stats.json
**/.agents/.channels/

# Interrupted atomic writes (name carries a pid + hash, so **/*.tmp misses them)
**/*.tmp.[0-9]*
