schemaVersion: 1
id: slack-cleared-root
name: Slack, cleared
kind: root
version: 0.1.0
description: Your Slack, caught up. Who is waiting on you, what you promised, what was decided, and what you can safely skip.
entry: index.md
domain: Operations
app: catch-up

# What this cabinet connects to. References only: accounts, ids and keys never appear here.
connectors:
  - id: slack
    need: needs
    access: [read, send]
    why: Reads your Slack each morning and sends only the replies you approve.
    hero: true

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: "Who is waiting for my answer in Slack?"
    connector: slack
  - text: "What did I promise people this week?"
    connector: slack
  - text: "Catch me up on Slack since Friday"
    connector: slack
  - text: "What was decided in #general this week?"
    connector: slack
  - text: "Write a reply to everyone waiting more than a day"
    connector: slack
  - text: "Which channels are loud but never need me?"
    connector: slack
  - text: "Find the file someone sent me in Slack"
    connector: slack
  - text: "Summarize my busiest channel this week"
    connector: slack
