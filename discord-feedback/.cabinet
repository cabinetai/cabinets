schemaVersion: 1
id: discord-feedback-root
name: Discord Feedback
kind: root
version: 0.1.0
description: Turns what your Discord community says in #feedback into a ranked board of requests, so you can see what people want most.
entry: index.md
domain: Operations
app: board
connectors:
  - id: discord
    need: needs
    access: [read]
    why: Reads the #feedback channel to collect what your community asks for.
    usedBy: [jobs/organize-feedback, agents/feedback-analyst]
    hero: true
prompts:
  - text: What do people ask for most right now?
    connector: discord
  - text: Which bugs did people report this week?
    connector: discord
  - text: Who asked for dark mode, and what did they say?
    connector: discord
