schemaVersion: 1
id: discord-feedback-root
name: Discord Feedback
kind: root
version: 0.2.1
description: "Turns what your Discord community says in #feedback into a ranked board of requests, so you can see what people want most."
entry: index.md
domain: Operations
app: board
connectors:
  - id: discord
    need: needs
    access: [read, post]
    why: "Reads #feedback and messages marked with a pin, and posts only when you ask."
prompts:
  - text: What do people ask for most right now?
    connector: discord
  - text: Which bugs did people report this week?
    connector: discord
  - text: Who asked for the top request, and what did they say?
    connector: discord
