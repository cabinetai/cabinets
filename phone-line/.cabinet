schemaVersion: 1
id: phone-line-root
name: Phone Line
kind: root
version: 0.1.0
description: Your business phone line. Who is waiting for a text back, the calls to return, and what callers asked for.
entry: index.md
domain: Operations

# The app this cabinet opens on: Cabinet's own phone app, which Cabinet writes
# into twilio/sms-conversations and keeps up to date. Older Cabinets open on index.md.
app: twilio/sms-conversations

# What this cabinet connects to. References only: accounts, numbers and keys never appear here.
connectors:
  - id: twilio
    need: needs
    access: [read, send]
    why: Reads the texts and calls on your business number, and sends the replies you send.
    hero: true
  - id: google-calendar
    need: better-with
    access: [change]
    why: Puts appointments from texts and calls on your calendar when you ask.

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: "Who is waiting for a text back?"
    connector: twilio
  - text: "Which calls did I miss today?"
    connector: twilio
  - text: "Summarize yesterday's calls."
    connector: twilio
  - text: "What did callers ask for this week?"
    connector: twilio
  - text: "Which customers asked for a quote this week?"
    connector: twilio
  - text: "Who haven't we answered in 24 hours?"
    connector: twilio
  - text: "Text back everyone whose call we missed today. Show me the drafts first."
    connector: twilio
  - text: "Draft reminders for tomorrow's appointments. Show me first."
    connector: twilio
  - text: "Follow up on quotes with no answer. Show me the drafts first."
    connector: twilio
  - text: "When do we miss the most calls?"
    connector: twilio
  - text: "Build my customer list from texts and calls."
    connector: twilio
  - text: "Find the address a customer texted me last week."
    connector: twilio
  - text: "Who texted or called us for the first time this week?"
    connector: twilio
  - text: "Put the appointments from texts and calls on my calendar."
    connector: google-calendar
