schemaVersion: 1
id: traffic-watch-root
name: Traffic Watch
kind: root
version: 0.1.0
description: Every morning, what on your website needs a look, ranked, each with the numbers and a next step.
entry: index.md
domain: Media
app: board
connectors:
  - id: google-analytics
    need: needs
    access: [read]
    why: Reads your visitors, pages, sources and key events to spot drops and jumps.
prompts:
  - text: Does anything on my website need my attention?
    connector: google-analytics
  - text: Why did my visitors drop?
    connector: google-analytics
  - text: Are my forms and orders still coming in?
    connector: google-analytics
  - text: Is anyone landing on a broken page?
    connector: google-analytics
  - text: Where did yesterday's jump in visitors come from?
    connector: google-analytics
  - text: Which new sites are sending me visitors?
    connector: google-analytics
  - text: Is Google Analytics still counting my visitors?
    connector: google-analytics
