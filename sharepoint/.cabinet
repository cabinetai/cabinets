schemaVersion: 1
id: sharepoint-root
name: Microsoft SharePoint
kind: root
version: 0.1.0
description: SharePoint keeps every file. This shows the few that changed for you, and which copy is the real one.
entry: index.md
domain: Operations
app: my-files

connectors:
  - id: sharepoint
    need: needs
    access: [read]
    why: Reads the files, lists and news on your SharePoint sites each morning. Changes nothing.
    hero: true

prompts:
  - text: "Which of my files did someone else change this week?"
    connector: sharepoint
  - text: "Where is the newest version of the price list?"
    connector: sharepoint
  - text: "What is assigned to me in our SharePoint lists?"
    connector: sharepoint
  - text: "Which of my files can people outside the company open?"
    connector: sharepoint
  - text: "What changed in the budget file since Monday?"
    connector: sharepoint
  - text: "Find the file about the supplier contract"
    connector: sharepoint
  - text: "List everything I worked on this month, for a handover"
    connector: sharepoint
  - text: "Which files nobody touched in a year?"
    connector: sharepoint
