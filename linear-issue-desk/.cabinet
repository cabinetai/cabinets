schemaVersion: 1
id: linear-issue-desk-root
name: Issue Desk
kind: root
version: 0.1.3
description: Your Linear at a glance. What is on you, what is due this week, what waits in triage, and how the cycle is going.
entry: index.md
domain: Operations

# The app this cabinet opens on.
app: issue-desk

# What this cabinet connects to. References only: accounts, workspaces and keys never appear here.
connectors:
  - id: linear
    need: needs
    access: [read, create]
    why: Reads your issues, projects and cycles. Makes an issue only when you press New issue.
    hero: true

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: What is on my plate today?
    connector: linear
  - text: What changed in Linear since yesterday?
    connector: linear
  - text: What is due this week?
    connector: linear
  - text: Which of my issues are stuck, and on what?
    connector: linear
  - text: What is waiting in triage, oldest first?
    connector: linear
  - text: Draft a new issue for a bug I will describe
    connector: linear
  - text: Which projects are at risk?
    connector: linear
  - text: Write my stand-up for today
    connector: linear
