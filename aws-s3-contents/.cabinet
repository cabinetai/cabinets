schemaVersion: 1
id: aws-s3-contents-root
name: AWS S3 Contents
kind: root
version: 0.1.1
description: What's actually in your bucket, and what changed last.
entry: index.md
domain: Operations
connectors:
  - id: aws-s3
    need: needs
    access: [read]
    why: Copies a folder from your bucket down to this cabinet and reads it.
    usedBy:
      - jobs/daily-bucket-contents
    hero: true
prompts:
  - text: What is actually in this bucket?
    connector: aws-s3
  - text: What changed in the last week?
    connector: aws-s3
  - text: Which folder is taking up the most room?
    connector: aws-s3
  - text: Has anything stopped arriving?
    connector: aws-s3
  - text: What has nobody touched in a year?
    connector: aws-s3
  - text: Find everything to do with invoices.
    connector: aws-s3
  - text: Is anything in here duplicated?
    connector: aws-s3
  - text: What is the oldest thing we are keeping?
    connector: aws-s3
