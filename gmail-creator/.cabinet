schemaVersion: 1
id: gmail-creator-root
name: Gmail for Creators
kind: root
version: 0.1.0
description: A brand desk for creators. Brand offers waiting for your answer, money brands still owe you, fake offers caught, and what your fans keep asking.
entry: index.md
domain: Media
app: brand-desk

connectors:
  - id: gmail
    need: needs
    access: [read, draft]
    why: Reads your email each morning to sort brand offers. Drafts only when you ask.

prompts:
  - text: "Which brands are waiting for my answer?"
    connector: gmail
  - text: "Which brands still owe me money?"
    connector: gmail
  - text: "Write my reply to the biggest offer"
    connector: gmail
  - text: "Send a polite reminder to every brand that pays late"
    connector: gmail
  - text: "Is this collab offer real or a scam?"
    connector: gmail
  - text: "What do my fans keep asking me?"
    connector: gmail
  - text: "List every brand I worked with this year and what they paid"
    connector: gmail
  - text: "Which offers are below my rate?"
    connector: gmail
