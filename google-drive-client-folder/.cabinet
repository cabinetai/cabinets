schemaVersion: 1
id: google-drive-client-folder-root
name: Client Folder
kind: root
version: 0.1.0
description: One client or project folder in Drive, with a page on top of it that stays current.
entry: index.md
domain: Professional Services
connectors:
  - id: google-drive
    need: needs
    access:
      - read
    why: Reads the client folder so the summary on top of it stays true.
    usedBy:
      - jobs/refresh-client-summary
      - jobs/friday-open-items
prompts:
  - text: What did we agree with this client?
    connector: google-drive
  - text: What is still open on this account?
    connector: google-drive
  - text: When does the contract renew?
    connector: google-drive
  - text: What have we invoiced and what is unpaid?
    connector: google-drive
  - text: Summarize the last three months on this account.
    connector: google-drive
  - text: What did we promise that we have not delivered?
    connector: google-drive
  - text: Who signed the statement of work?
    connector: google-drive
  - text: Has anything changed since the kickoff?
    connector: google-drive
