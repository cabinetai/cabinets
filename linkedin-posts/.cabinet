schemaVersion: 1
id: linkedin-posts-root
name: LinkedIn Posts
kind: root
version: 0.1.0
description: Write your LinkedIn posts with an agent in the chat, keep every draft in one place, and publish one only when you say yes.
entry: index.md
domain: Media
app: your-posts
connectors:
  - id: linkedin
    need: needs
    access: [read, post]
    why: Signs you in and publishes a post only when you ask in the chat.
    usedBy: [agents/post-writer]
    hero: true
prompts:
  - text: Draft a LinkedIn post about what I shipped this week
    connector: linkedin
  - text: Turn this note into a LinkedIn post
    connector: linkedin
  - text: Make three variants of this post
    connector: linkedin
  - text: Which of my drafts is ready to publish?
    connector: linkedin
  - text: Make my newest draft shorter and sharper
    connector: linkedin
  - text: Publish my approved draft to my connections
    connector: linkedin
  - text: Give me three post ideas from my notes
    connector: linkedin
  - text: Write a post thanking my team for the launch
    connector: linkedin
  - text: Bring in my LinkedIn posts
