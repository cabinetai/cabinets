schemaVersion: 1
id: trello-board-desk-root
name: Board Desk
kind: root
version: 0.1.5
description: Your Trello boards, cards, due dates and recent moves on one desk.
entry: index.md
domain: Operations
app: home
connectors:
  - id: trello
    need: needs
    access: [read, create, change]
    why: Reads your boards and changes cards after you say yes.
    hero: true
prompts:
  - text: Summarize a Trello board
    connector: trello
  - text: What is due for me this week?
    connector: trello
  - text: Draft a weekly recap
    connector: trello
  - text: Add a comment to a Trello card
    connector: trello
  - text: Create a card in a Trello list
    connector: trello
  - text: Move a Trello card to another list
    connector: trello
  - text: Archive a Trello card
    connector: trello
