schemaVersion: 1
id: notion-library-root
name: Notion Library
kind: root
version: 0.3.0
description: Your company's knowledge at a glance. What is in your Notion, what changed, what may be out of date, and answers to any question.
entry: index.md
app: library
domain: Operations
connectors:
  - id: notion
    need: needs
    access: [read]
    why: Reads the pages your team keeps in Notion, to sum them up and answer questions.
    hero: true
prompts:
  - text: What is our refund policy?
    connector: notion
  - text: What did we decide at our last team meeting?
    connector: notion
  - text: How much paid time off does a new hire get?
    connector: notion
  - text: Where do we keep our price list?
    connector: notion
  - text: What should a new employee read first?
    connector: notion
  - text: Which procedures and policies may be out of date?
    connector: notion
  - text: Build an employee handbook from our Notion pages
    connector: notion
  - text: Turn this week's meeting notes into action items with owners
    connector: notion
  - text: Build a client directory from our Notion pages
    connector: notion
  - text: Summarize what changed in our Notion this week for the team
    connector: notion
  - text: Explain our refund and warranty policy in plain words
    connector: notion
  - text: Which of our Notion pages have no clear owner?
    connector: notion
  - text: Find pages in our Notion that contradict each other
    connector: notion
