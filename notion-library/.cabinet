schemaVersion: 1
id: notion-library-root
name: Notion Library
kind: root
version: 0.1.1
description: Every morning, a list of the Notion pages you shared, with what each one is actually about.
entry: index.md
domain: Operations
connectors:
  - id: notion
    need: needs
    access: [read]
    why: Reads the pages and databases you shared with Cabinet.
    hero: true
prompts:
  - text: Where did I put the onboarding notes?
    connector: notion
  - text: Which Notion pages changed this week?
    connector: notion
  - text: What's in my projects database?
    connector: notion
  - text: Find my page about pricing
    connector: notion
  - text: Which pages haven't been touched in months?
    connector: notion
