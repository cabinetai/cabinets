schemaVersion: 1
id: slack-digest-root
name: Slack Catch-up
kind: root
version: 0.2.0
description: Every morning, who is waiting on you in Slack, and what was decided without you.
entry: index.md
domain: Operations
connectors:
  - id: slack
    need: needs
    access: [read, create]
    why: Reads what waits on you. Sets your own reminders only if you allow it.
    hero: true
prompts:
  - text: Who is waiting on me in Slack right now?
    connector: slack
  - text: Did anyone ask me something I never answered?
    connector: slack
  - text: Which of my threads moved since yesterday?
    connector: slack
  - text: What did my team decide in Slack this week?
    connector: slack
  - text: When did we decide the release date, and who agreed?
    connector: slack
  - text: Who mentioned me while I was away last week?
    connector: slack
  - text: Remind me at 2pm to answer the most urgent one
    connector: slack
