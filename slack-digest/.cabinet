schemaVersion: 1
id: slack-digest-root
name: Slack Digest
kind: root
version: 0.1.1
description: Every morning, what moved in all your Slack channels in the last 24 hours, and which of it wants you.
entry: index.md
domain: Operations
connectors:
  - id: slack
    need: needs
    access: [read]
    why: Reads the last day of messages in every channel you can see.
    hero: true
prompts:
  - text: Which channels need an answer from me today?
    connector: slack
  - text: What did the team decide in Slack yesterday?
    connector: slack
  - text: Did anyone mention me in a channel yesterday?
    connector: slack
  - text: Which channel was busiest yesterday?
    connector: slack
  - text: Summarize the general channel from this week
    connector: slack
