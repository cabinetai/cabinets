schemaVersion: 1
id: slack-digest-root
name: Slack Digest
kind: root
version: 0.2.0
description: Every morning, what moved in each of your Slack channels, the ones that need you first.
entry: index.md
domain: Operations
app: your-slack
connectors:
  - id: slack
    need: needs
    access: [read, post]
    why: Reads your channels and messages, and posts only when you ask, where you allow it.
    hero: true
prompts:
  - text: Who is waiting on me in Slack?
    connector: slack
  - text: Did anyone mention me yesterday?
    connector: slack
  - text: What did the team decide this week?
    connector: slack
  - text: What did I promise to do?
    connector: slack
  - text: Which channel was busiest yesterday?
    connector: slack
  - text: Summarize the general channel from this week
    connector: slack
  - text: Draft my standup from yesterday's Slack
    connector: slack
  - text: Draft a reply to everyone still waiting on me
    connector: slack
