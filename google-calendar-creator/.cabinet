schemaVersion: 1
id: google-calendar-creator-root
name: Calendar for Creators
kind: root
version: 0.1.0
description: Your shoot week. Posts going live and deadlines, shoot days with the light at each place, clashes to fix, and brand deal dates to put on your calendar.
entry: index.md
app: shoot-week
domain: Media
connectors:
  - id: google-calendar
    need: needs
    access: [read, create]
    why: Reads your week. Adds an event only when you say yes in chat.
  - id: gmail
    need: better-with
    access: [read]
    why: Finds the dates in your brand deals, so you can put them on your calendar.
prompts:
  - text: What goes live this week?
    connector: google-calendar
  - text: When is golden hour at my next shoot?
    connector: google-calendar
  - text: Plan my next shoot, with a shot list
    connector: google-calendar
  - text: Do any of my posts or shoots clash this week?
    connector: google-calendar
  - text: Find 2 hours to edit before my next deadline
    connector: google-calendar
  - text: Put my latest brand deal on my calendar
    connector: gmail
  - text: Which brand dates are not on my calendar yet?
    connector: gmail
