schemaVersion: 1
id: apple-notes-library-root
name: Notes Library
kind: root
version: 0.1.0
description: Turns years of Apple Notes into a short shelf of topics you can read and ask about.
entry: index.md
domain: Knowledge
app: your-library
connectors:
  - id: apple-notes
    need: needs
    access: [read]
    why: Reads the notes you imported from Apple Notes and sorts them into topics.
prompts:
  - text: What do my notes say about the flat move?
    connector: apple-notes
  - text: What did I decide about the car?
    connector: apple-notes
  - text: Which of my notes look like duplicates?
    connector: apple-notes
  - text: What have I been writing about most this year?
    connector: apple-notes
  - text: Find my notes about recipes
    connector: apple-notes
  - text: What questions do my notes never answer?
    connector: apple-notes
