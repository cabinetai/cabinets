schemaVersion: 1
id: gmail-personal-root
name: Gmail for Personal
kind: root
version: 0.1.0
description: Your own inbox, calm. Who you should answer, bills and appointments coming up, and deliveries on the way. Ads stay out of sight.
entry: index.md
domain: Lifestyle
app: front-desk

connectors:
  - id: gmail
    need: needs
    access: [read, send]
    why: Reads your email each morning to sort it. Nothing is sent without your OK.

prompts:
  - text: "Who should I answer?"
    connector: gmail
  - text: "What bills are due this month?"
    connector: gmail
  - text: "Do I have any appointments coming up?"
    connector: gmail
  - text: "Where are my packages?"
    connector: gmail
  - text: "Anything from school this week?"
    connector: gmail
  - text: "Anything from the bank?"
    connector: gmail
  - text: "What subscriptions am I paying for?"
    connector: gmail
  - text: "Which newsletters do I never open?"
    connector: gmail
  - text: "Draft a reply to everyone waiting more than 3 days"
    connector: gmail
  - text: "Find the warranty for my washing machine"
    connector: gmail
