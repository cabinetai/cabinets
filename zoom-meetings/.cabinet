schemaVersion: 1
id: zoom-meetings-root
name: Zoom Meetings
kind: root
version: 0.1.0
description: Your meetings, recordings and summaries as pages, with the next one a press away and an assistant who reads them.
entry: index.md
domain: Operations

# Cabinet draws this cabinet's home itself from the Zoom copy: the next meeting with Join, your
# meeting room, upcoming, recent, recordings, summaries, the tools and an ask box.
connectors:
  - id: zoom
    need: needs
    access: [read, create]
    why: Reads your meetings, recordings and summaries; makes a meeting when you press Start.
    hero: true

prompts:
  - text: What are my meetings this week?
    connector: zoom
  - text: What did we decide in my last meeting?
    connector: zoom
  - text: Summarise my last meeting
    connector: zoom
  - text: Who did I meet with most this month?
    connector: zoom
  - text: Which meetings have no summary yet?
    connector: zoom
  - text: Make tasks from the next steps of my last meeting
    connector: zoom
