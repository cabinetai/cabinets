      - ashby
      - aws-s3
      - backblaze-b2
      - bamboohr
      - bigquery
      - box
      - brex
      - brightdata
      - calendly
      - chrome
      - claude-code
      - clickup
      - clockwise
      - cloudflare-r2
      - codex
      - confluence
      - databricks
      - datadog
      - digitalocean-spaces
      - discord
      - docusign
      - dropbox
      - expensify
      - figma
      - gemini
      - gemini-cli
      - gitlab
      - gong
      - google-ads
      - google-analytics
      - google-cloud-storage
      - greenhouse
      - higgsfield
      - hubspot
      - icloud
      - imessage
      - instagram
      - intercom
      - jira
      - lever
