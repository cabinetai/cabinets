schemaVersion: 1
id: teams-digest-root
name: Teams Digest
kind: root
version: 0.2.0
description: Your Teams, caught up. Who is waiting on you, what you promised, what was decided, and what you can safely skip.
entry: index.md
domain: Operations
app: catch-up

connectors:
  - id: microsoft-teams
    need: needs
    access: [read]
    why: Reads your Teams chats and channels each morning. Nothing is posted.
    hero: true

prompts:
  - text: "Who is waiting for my answer in Teams?"
    connector: microsoft-teams
  - text: "What did I promise people this week?"
    connector: microsoft-teams
  - text: "Catch me up on Teams since Friday"
    connector: microsoft-teams
  - text: "What was decided in my meetings yesterday?"
    connector: microsoft-teams
  - text: "Write a reply to everyone waiting more than a day"
    connector: microsoft-teams
  - text: "Which chats are loud but never need me?"
    connector: microsoft-teams
  - text: "Find the file someone sent me in a chat"
    connector: microsoft-teams
  - text: "Summarize my busiest channel this week"
    connector: microsoft-teams
