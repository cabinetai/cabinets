schemaVersion: 1
id: teams-digest-root
name: Teams Digest
kind: root
version: 0.1.1
description: Every morning, what moved in your Teams channels in the last 24 hours, and which of it wants you.
entry: index.md
domain: Operations
connectors:
  - id: microsoft-teams
    need: needs
    access: [read]
    why: Reads the last day of messages in the Teams channels you belong to.
    hero: true
prompts:
  - text: Which Teams channels need an answer from me?
    connector: microsoft-teams
  - text: What did the team decide in General yesterday?
    connector: microsoft-teams
  - text: Did anyone mention me in a channel yesterday?
    connector: microsoft-teams
  - text: Which channel was busiest yesterday?
    connector: microsoft-teams
  - text: Summarize the Marketing channel from this week
    connector: microsoft-teams
