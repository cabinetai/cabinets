schemaVersion: 1
id: google-calendar-week-root
name: Google Calendar Week
kind: root
version: 0.3.0
description: Your week at a glance. What is on now and next, when you are free, and help before and after every meeting.
entry: index.md
app: calendar-brief
domain: Operations
connectors:
  - id: google-calendar
    need: needs
    access: [read, change]
    why: Reads your week, and changes an event only when you ask in chat.
    hero: true
prompts:
  - text: What does my week look like?
    connector: google-calendar
  - text: When am I free this week?
    connector: google-calendar
  - text: Prep me for tomorrow's meetings
    connector: google-calendar
  - text: Do any of my events overlap this week?
    connector: google-calendar
  - text: Who haven't I seen in 60 days?
    connector: google-calendar
  - text: Draft follow-ups for today's meetings
    connector: google-calendar
