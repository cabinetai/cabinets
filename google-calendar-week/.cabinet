schemaVersion: 1
id: google-calendar-week-root
name: Google Calendar Week
kind: root
version: 0.2.0
description: Your calendar working for your business. Every client meeting, a client list built from your meetings, and who is going quiet.
entry: index.md
app: calendar-brief
domain: Operations
connectors:
  - id: google-calendar
    need: needs
    access: [read, change]
    why: Reads your meetings, and changes an event only when you ask in chat.
    hero: true
prompts:
  - text: Who are my clients this month?
    connector: google-calendar
  - text: Which clients have I not seen in 60 days?
    connector: google-calendar
  - text: How many hours did I spend with each client this month?
    connector: google-calendar
  - text: Prep me for tomorrow's client meetings
    connector: google-calendar
  - text: When do I have time for sales calls next week?
    connector: google-calendar
  - text: Draft follow-ups for today's client meetings
    connector: google-calendar
