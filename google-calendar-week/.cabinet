schemaVersion: 1
id: google-calendar-week-root
name: Calendar for Business
kind: root
version: 0.4.0
description: Your work week with clients. Meetings to prepare and follow up, free time for new work, and clients you have not met in a while.
entry: index.md
app: calendar-brief
domain: Operations
connectors:
  - id: google-calendar
    need: needs
    access: [read, change]
    why: Reads your week, and changes an event only when you ask in chat.
    hero: true
prompts:
  - text: What meetings do I have this week?
    connector: google-calendar
  - text: Prep me for tomorrow's client meetings
    connector: google-calendar
  - text: Draft follow-ups for today's meetings
    connector: google-calendar
  - text: Do any of my meetings overlap this week?
    connector: google-calendar
  - text: When am I free for a new client this week?
    connector: google-calendar
  - text: Which clients haven't I met in 60 days?
    connector: google-calendar
  - text: How many hours did I spend with clients this week?
    connector: google-calendar
  - text: Who do I meet most, by company?
    connector: google-calendar
