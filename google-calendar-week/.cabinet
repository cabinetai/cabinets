schemaVersion: 1
id: google-calendar-week-root
name: Google Calendar Week
kind: root
version: 0.1.1
description: Every morning, what's on your calendar today, with the rest of the week behind it.
entry: index.md
domain: Operations
connectors:
  - id: google-calendar
    need: needs
    access: [read, change]
    why: Reads today and the rest of the week, and changes an event only when you ask.
    hero: true
prompts:
  - text: When am I free on Wednesday?
    connector: google-calendar
  - text: What's my busiest day this week?
    connector: google-calendar
  - text: Who am I meeting on Thursday?
    connector: google-calendar
  - text: What's on my calendar tomorrow morning?
    connector: google-calendar
