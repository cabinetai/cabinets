schemaVersion: 1
id: google-ads-brief-root
name: Google Ads Brief
kind: root
version: 0.1.1
description: Every Monday, where last week's ad money went and what it bought.
entry: index.md
domain: Marketing
connectors:
  - id: google-ads
    need: needs
    access: [read]
    why: Reads last week's campaign spend and what it bought.
    hero: true
prompts:
  - text: Which campaign spent the most last week?
    connector: google-ads
  - text: What did a conversion cost me last week?
    connector: google-ads
  - text: Which campaigns got worse than the week before?
    connector: google-ads
  - text: Is any campaign spending money without converting?
    connector: google-ads
  - text: How much have I spent on Google Ads this month?
    connector: google-ads
