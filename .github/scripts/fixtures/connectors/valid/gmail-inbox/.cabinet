schemaVersion: 1
id: gmail-inbox-root
name: Gmail Inbox
kind: root
version: 0.1.0
description: A fixture cabinet for the connector checks.
entry: index.md
domain: Operations
connectors:
  - id: gmail
    need: needs
    access: [read]
    why: Reads the mail that arrived overnight.
    usedBy: [jobs/morning-summary]
    hero: true
  - anyOf: [google-calendar, microsoft-365]
    need: better-with
    access: [read, change]
    why: Adds today's meetings beside the mail.
    usedBy: [agents/summarizer]
  - anyOf: [notion, slack]
    need: needs
    open: true
    why: Reads whichever notes or chats are connected.
prompts:
  - text: What needs me in today's mail?
    connector: gmail
  - text: Which meetings clash this week?
    connector: google-calendar
  - Summarise the last three mornings.
