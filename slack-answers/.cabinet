schemaVersion: 1
id: slack-answers-root
name: Slack Answers
kind: root
version: 0.1.1
description: Every question your team has already answered in Slack, written down once so nobody has to ask it again.
entry: index.md
domain: Operations
connectors:
  - id: slack
    need: needs
    access:
      - read
    why: Reads the channels you chose, looking for questions that got a real answer.
prompts:
  - text: Which questions keep coming back in Slack?
    connector: slack
  - text: Has anyone already answered this in Slack?
    connector: slack
  - text: Which questions were asked but never answered?
    connector: slack
  - text: Which answers changed this month?
    connector: slack
  - text: What should go in the team wiki first?
    connector: slack
