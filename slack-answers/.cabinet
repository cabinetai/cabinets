schemaVersion: 1
id: slack-answers-root
name: Slack Team Memory
kind: root
version: 0.2.0
description: Every question your team has already answered in Slack, kept as a page in your knowledge base so nobody has to ask it again.
entry: index.md
domain: Operations
app: answer-book
connectors:
  - id: slack
    need: needs
    access:
      - read
      - post
      - create
    why: Reads your channels. Posts a reply or a canvas only after your yes in the chat.
prompts:
  - text: Which questions keep coming back in Slack?
    connector: slack
  - text: Has anyone already answered this in Slack?
    connector: slack
  - text: Which questions were asked but never answered?
    connector: slack
  - text: Which answers changed this month?
    connector: slack
  - text: What did the last sweep add to our team memory?
  - text: What should go in the team handbook first?
  - text: Which answers have not been confirmed in three months?
  - text: Put the top answers in a Slack canvas
    connector: slack
