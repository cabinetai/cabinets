schemaVersion: 1
id: google-calendar-personal-root
name: Calendar for Personal
kind: root
version: 0.1.0
description: Your own week, calm. What is on today, appointments and plans coming up, birthdays, and your free evenings and weekends.
entry: index.md
app: calendar-brief
domain: Lifestyle
connectors:
  - id: google-calendar
    need: needs
    access: [read, change]
    why: Reads your week, and changes an event only when you ask in chat.
prompts:
  - text: What's on this weekend?
    connector: google-calendar
  - text: When is the next dentist appointment?
    connector: google-calendar
  - text: Whose birthday is coming up?
    connector: google-calendar
  - text: When are we all free this week?
    connector: google-calendar
  - text: What does school need from us this week?
    connector: google-calendar
  - text: Do any of my plans overlap this week?
    connector: google-calendar
  - text: Plan a free Saturday for the family
    connector: google-calendar
  - text: What's my week ahead?
    connector: google-calendar
