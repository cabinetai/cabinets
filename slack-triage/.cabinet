schemaVersion: 1
id: slack-triage-root
name: Slack Triage
kind: root
version: 0.1.0
description: Everything the support channel asked for, as a list of items with an owner and a state, instead of a wall of messages.
entry: index.md
domain: Operations
connectors:
  - id: slack
    need: needs
    access:
      - read
    why: Reads the support channel you chose and turns what it asks for into items.
