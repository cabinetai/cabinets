schemaVersion: 1
id: slack-triage-root
name: Slack Support Desk
kind: root
version: 0.2.0
description: Every request in your team's Slack support channel on one board, what is still owed, by whom, and how long it has waited.
entry: index.md
domain: Operations
app: triage-board
connectors:
  - id: slack
    need: needs
    access:
      - read
      - post
    why: Reads your support channel. Posts only what you approve in chat, where you set Write.
    usedBy:
      - jobs/support-triage
      - agents/triage-desk
prompts:
  - text: What in the support channel has no owner yet?
    connector: slack
  - text: Which requests have had no owner for over 4 hours?
    connector: slack
  - text: What is the oldest open request, and who has it?
    connector: slack
  - text: What is waiting on a customer right now?
    connector: slack
  - text: What did support finish today?
    connector: slack
  - text: Which kind of request came in most this week?
    connector: slack
  - text: Which request will hurt most if it sits until tomorrow?
    connector: slack
  - text: Draft a nudge for the requests past our limit
    connector: slack
