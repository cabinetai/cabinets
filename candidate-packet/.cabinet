schemaVersion: 1
id: candidate-packet-root
name: Candidate Packet
kind: root
version: 0.1.1
description: Structured candidate packets for hiring committees — resume summary, interview notes digest, take-home assessment, scorecard by competency, and committee recommendation — produced before the debrief. Keeps your ATS as the system of record and replaces Greenhouse notes that nobody reads before the room.
entry: index.md
domain: Operations
connectors:
  - anyOf: [greenhouse, lever, ashby]
    need: better-with
    access: [read]
    why: Reads interview notes and scorecards from your hiring system.
  - id: google-calendar
    need: better-with
    access: [read]
    why: Reads when each debrief is, so its packet is ready in time.
  - anyOf: [gmail, microsoft-365]
    need: better-with
    access: [read]
    why: Reads candidate correspondence and interview feedback sent by mail.
  - id: whatsapp
    need: better-with
    access: [read]
    why: Reads messages about a candidate in the chats you pick.
