schemaVersion: 1
id: google-calendar-freelance-root
name: Calendar for Freelancers
kind: root
version: 0.1.0
description: Your hours with each client, ready for invoices. Today's client meetings, free time for new work, and clients gone quiet.
entry: index.md
app: calendar-brief
domain: Professional Services
connectors:
  - id: google-calendar
    need: needs
    access: [read, change]
    why: Reads your week, and changes an event only when you ask in chat.
prompts:
  - text: How many hours did I work for each client this week?
    connector: google-calendar
  - text: Make my hours list for this month's invoices
    connector: google-calendar
  - text: Prep me for tomorrow's client meetings
    connector: google-calendar
  - text: When am I free for a new project this week?
    connector: google-calendar
  - text: Which clients haven't I met in 60 days?
    connector: google-calendar
  - text: Draft follow-ups for today's meetings
    connector: google-calendar
  - text: Do any of my meetings overlap this week?
    connector: google-calendar
  - text: Which client took the most of my time this month?
    connector: google-calendar
