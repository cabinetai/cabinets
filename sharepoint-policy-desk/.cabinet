schemaVersion: 1
id: sharepoint-policy-desk-root
name: Policy Desk
kind: root
version: 0.1.0
description: Ask what the company policy says. The answer comes back with the document it came from.
entry: index.md
domain: Professional Services
connectors:
  - id: sharepoint
    need: needs
    access:
      - read
    why: Reads the policy library your company already keeps in SharePoint.
    hero: true
prompts:
  - text: What is our policy on working from home?
    connector: sharepoint
  - text: Can I expense a taxi home after 9pm?
    connector: sharepoint
  - text: Which policies are overdue for review?
    connector: sharepoint
