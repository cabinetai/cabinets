schemaVersion: 1
id: stackadapt-brief-root
name: StackAdapt Brief
kind: root
version: 0.1.1
description: Every Monday, where last week's programmatic spend went and what it bought.
entry: index.md
domain: Marketing
connectors:
  - id: stackadapt
    need: needs
    access: [read]
    why: Reads last week's programmatic spend and what it bought.
    hero: true
prompts:
  - text: Which StackAdapt campaign spent the most last week?
    connector: stackadapt
  - text: What did a conversion cost me last week?
    connector: stackadapt
  - text: Which campaigns got worse than the week before?
    connector: stackadapt
  - text: How much have I spent on StackAdapt this month?
    connector: stackadapt
