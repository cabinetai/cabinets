schemaVersion: 1
id: github-dev-brief-root
name: GitHub Dev Brief
kind: root
version: 0.1.1
description: Every morning, what you shipped and what's waiting on you across GitHub in the last 24 hours.
entry: index.md
domain: Operations
connectors:
  - id: github
    need: needs
    access: [read]
    why: Reads your commits, pull requests, reviews and issues from the last day.
    hero: true
prompts:
  - text: Which pull requests are waiting on my review?
    connector: github
  - text: What did I merge yesterday?
    connector: github
  - text: Which issues are assigned to me?
    connector: github
  - text: Did any of my pull requests get comments overnight?
    connector: github
  - text: What did I ship this week?
    connector: github
