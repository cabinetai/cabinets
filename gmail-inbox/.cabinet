schemaVersion: 1
id: gmail-inbox-root
name: Gmail for Business
kind: root
version: 0.4.0
description: A front desk for your business inbox. Customers and leads waiting on you, quotes with no answer, and who went quiet.
entry: index.md
domain: Operations
app: front-desk

connectors:
  - id: gmail
    need: needs
    access: [read, send]
    why: Reads your email each morning to sort it. Nothing is sent without your OK.
    hero: true

prompts:
  - text: "Who's waiting on a reply?"
    connector: gmail
  - text: "Did any new customers write?"
    connector: gmail
  - text: "List every new lead this week"
    connector: gmail
  - text: "Which quotes have no answer yet?"
    connector: gmail
  - text: "Follow up on quotes with no answer"
    connector: gmail
  - text: "Draft replies to everyone waiting more than 2 days"
    connector: gmail
  - text: "Which customers have gone quiet?"
    connector: gmail
  - text: "Build my customer list from my email"
    connector: gmail
  - text: "Write a weekly summary for my business partner"
    connector: gmail
