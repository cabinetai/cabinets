schemaVersion: 1
id: gmail-inbox-root
name: Gmail Inbox
kind: root
version: 0.2.0
description: Every morning, a plain-English summary of the email that arrived overnight.
entry: index.md
domain: Operations

connectors:
  - id: gmail
    need: needs
    access: [read, send]
    why: Reads your mail and writes replies you approve.
    hero: true

prompts:
  - text: "What needs me in today's mail?"
    connector: gmail
  - text: "Who's waiting on a reply from me?"
    connector: gmail
  - text: "Find last month's electricity bill"
    connector: gmail
  - text: "Draft a reply saying Tuesday works"
    connector: gmail
  - text: "What did the school send this week?"
    connector: gmail
  - text: "Any receipts I should file?"
    connector: gmail
  - text: "Summarize the thread with the landlord"
    connector: gmail
  - text: "Which newsletters can I unsubscribe from?"
    connector: gmail
  - text: "What deliveries are on the way?"
    connector: gmail
  - text: "Did anyone ask me for something by Friday?"
    connector: gmail
  - text: "Write a polite no to the conference invite"
    connector: gmail
  - text: "What changed in the project thread since Monday?"
    connector: gmail
