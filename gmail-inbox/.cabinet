schemaVersion: 1
id: gmail-inbox-root
name: Gmail Inbox
kind: root
version: 0.3.0
description: A front desk for your business inbox. Who is waiting on you, what you are owed, and which bills are due.
entry: index.md
domain: Operations
app: front-desk

connectors:
  - id: gmail
    need: needs
    access: [read, send]
    why: Reads your email each morning to sort it. Nothing is sent without your OK.
    hero: true

prompts:
  - text: "Who's waiting on a reply?"
    connector: gmail
  - text: "Any unpaid invoices?"
    connector: gmail
  - text: "What bills are due this week?"
    connector: gmail
  - text: "Did any new customers write?"
    connector: gmail
  - text: "Anything from the bank?"
    connector: gmail
  - text: "List every new lead this week"
    connector: gmail
  - text: "Which invoices are overdue?"
    connector: gmail
  - text: "Build my customer list from my email"
    connector: gmail
  - text: "Draft replies to everyone waiting more than 2 days"
    connector: gmail
  - text: "Write a weekly summary for my business partner"
    connector: gmail
  - text: "Find this month's receipts for my bookkeeper"
    connector: gmail
  - text: "Which customers have gone quiet?"
    connector: gmail
  - text: "Follow up on quotes with no answer"
    connector: gmail
