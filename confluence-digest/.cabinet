schemaVersion: 1
id: confluence-digest-root
name: Confluence Digest
kind: root
version: 0.1.1
description: Every morning, what changed in your team's wiki and which of it you need to read.
entry: index.md
domain: Operations
connectors:
  - id: confluence
    need: needs
    access: [read]
    why: Reads the wiki pages that changed overnight.
    hero: true
prompts:
  - text: Which wiki pages changed overnight?
    connector: confluence
  - text: What changed on the onboarding page this week?
    connector: confluence
  - text: Who edited the roadmap page recently?
    connector: confluence
  - text: Which page edits should I read today?
    connector: confluence
