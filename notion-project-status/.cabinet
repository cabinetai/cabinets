schemaVersion: 1
id: notion-project-status-root
name: Notion Project Status
kind: root
version: 0.3.0
description: Every open project in your Notion at a glance, late, at risk or on track, with owners, dates and what changed.
entry: index.md
app: project-status
domain: Operations
connectors:
  - id: notion
    need: needs
    access: [read]
    why: Reads the projects your team keeps in Notion.
prompts:
  - text: What should I chase today?
    connector: notion
  - text: Who has too much on their plate?
    connector: notion
  - text: What's due in the next two weeks?
    connector: notion
  - text: Which projects haven't moved in a while?
    connector: notion
  - text: What do I need to decide this week?
    connector: notion
  - text: Write a short status email for the team from our projects
    connector: notion
  - text: List everything overdue and who owns it
    connector: notion
  - text: Write a client update for one of our projects
    connector: notion
  - text: Which projects have no owner or no due date?
    connector: notion
  - text: What changed in our projects since last week?
    connector: notion
  - text: Which jobs are waiting on a customer or a supplier?
    connector: notion
  - text: What should each person on the team focus on this week?
    connector: notion
  - text: What did we finish this month?
    connector: notion
