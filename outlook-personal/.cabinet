schemaVersion: 1
id: outlook-personal-root
name: Outlook for Personal
kind: root
version: 0.1.0
description: Your own Outlook, calm. Today's plans on the fridge door, people to answer, bills, parcels and what is coming up.
entry: index.md
domain: Lifestyle
app: my-day

connectors:
  - id: outlook
    need: needs
    access: [read, draft]
    why: Reads your mail each morning. Drafts wait in Outlook, nothing is sent.
  - id: outlook-calendar
    need: better-with
    access: [read]
    why: Reads today's plans and the week ahead from your calendar.

prompts:
  - text: "What do I need to do today?"
    connector: outlook
  - text: "Which bills are due this week?"
    connector: outlook
  - text: "Who is waiting for my answer?"
    connector: outlook
  - text: "When does my parcel arrive?"
    connector: outlook
  - text: "What is on this weekend?"
    connector: outlook-calendar
  - text: "Whose birthday is coming up?"
    connector: outlook-calendar
  - text: "What do I pay for every month?"
    connector: outlook
  - text: "Find the receipt for my new fridge"
    connector: outlook
