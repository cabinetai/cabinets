schemaVersion: 1
id: outlook-root
name: Outlook
kind: root
version: 0.1.0
description: Your Outlook day on one page. Meetings with what to know before each, and the replies that fit between them.
entry: index.md
domain: Operations
app: my-day

connectors:
  - id: outlook
    need: needs
    access: [read, draft]
    why: Reads your mail each morning. Drafts wait in Outlook, nothing is sent.
  - id: outlook-calendar
    need: better-with
    access: [read]
    why: Reads today's meetings so replies can fit around them.

prompts:
  - text: "What should I answer first?"
    connector: outlook
  - text: "Who has been waiting longest for me?"
    connector: outlook
  - text: "Find me a free hour this week"
    connector: outlook-calendar
  - text: "What do I need for my next meeting?"
    connector: outlook-calendar
  - text: "Draft a reply to everyone waiting more than 2 days"
    connector: outlook
  - text: "What did I promise people this week?"
    connector: outlook
  - text: "Which meetings tomorrow have no agenda?"
    connector: outlook-calendar
  - text: "Summarize the longest thread in my inbox"
    connector: outlook
