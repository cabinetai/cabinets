schemaVersion: 1
id: whatsapp-catch-up-root
name: WhatsApp Catch-Up
kind: root
version: 0.2.0
description: Who needs you in your chats, what you planned, and what you promised.
entry: index.md
domain: Lifestyle

# The app this cabinet opens on: the folder name, directly inside the cabinet.
app: today

# What this cabinet connects to. References only: accounts, numbers and keys never appear here.
connectors:
  - id: whatsapp
    need: needs
    access: [read, send]
    why: Reads the chats you pick and drafts replies you approve.
    hero: true
  - id: google-calendar
    need: better-with
    access: [change]
    why: Puts plans from your chats on your calendar when you ask.

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: "Who is waiting for my reply?"
    connector: whatsapp
  - text: "What did I agree with the plumber?"
    connector: whatsapp
  - text: "What did I promise to do this week?"
    connector: whatsapp
  - text: "What plans did I make for this weekend?"
    connector: whatsapp
  - text: "Who said they'd get back to me and hasn't?"
    connector: whatsapp
  - text: "Write a reply to the supplier. Show me before anything is sent."
    connector: whatsapp
  - text: "What prices did people quote me this month?"
    connector: whatsapp
  - text: "Find the address someone sent me last month."
    connector: whatsapp
  - text: "Did I promise to call anyone back today?"
    connector: whatsapp
  - text: "Which chats went quiet that I should follow up on?"
    connector: whatsapp
  - text: "Sum up the building committee chat from this week."
    connector: whatsapp
  - text: "Who wrote to me from a number I haven't saved?"
    connector: whatsapp
  - text: "From now on, skip the school parents group."
    connector: whatsapp
  - text: "Put the plans from my chats on my calendar."
    connector: google-calendar
