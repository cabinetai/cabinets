schemaVersion: 1
id: whatsapp-catch-up-root
name: WhatsApp Catch-Up
kind: root
version: 0.1.0
description: Who needs you in your chats, what you planned, and what you promised.
entry: index.md
domain: Lifestyle

# What this cabinet connects to. References only: accounts, numbers and keys never appear here.
connectors:
  - id: whatsapp
    need: needs
    access: [read, send]
    why: Reads the chats you pick and drafts replies you approve.
    hero: true
  - id: google-calendar
    need: better-with
    access: [change]
    why: Puts plans from your chats on your calendar when you ask.

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: "Who is waiting for my reply?"
    connector: whatsapp
  - text: "What did I agree with the plumber?"
    connector: whatsapp
  - text: "Summarize the building committee chat from this week."
    connector: whatsapp
  - text: "What plans did I make for this weekend?"
    connector: whatsapp
  - text: "Draft a reply saying Tuesday works for me."
    connector: whatsapp
  - text: "What did I promise to send, and to whom?"
    connector: whatsapp
  - text: "Find the address the supplier sent me last month."
    connector: whatsapp
  - text: "Which chats went quiet that I should follow up on?"
    connector: whatsapp
  - text: "What prices did the contractors quote me?"
    connector: whatsapp
  - text: "Put the plans from my chats on my calendar."
    connector: google-calendar
  - text: "What's still open with the moving company?"
    connector: whatsapp
  - text: "Remind me what the client asked for on Monday."
    connector: whatsapp
  - text: "Who said they'd get back to me and hasn't yet?"
    connector: whatsapp
  - text: "What prices did I agree to this month, and with whom?"
    connector: whatsapp
  - text: "Who wrote to me from a number I haven't saved?"
    connector: whatsapp
  - text: "Did I promise to call anyone back today?"
    connector: whatsapp
