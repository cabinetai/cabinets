schemaVersion: 1
id: whatsapp-catch-up-root
name: WhatsApp Catch-Up
kind: root
version: 0.3.0
description: Who needs you in your chats, what you planned, and what you promised.
entry: index.md
domain: Operations

# The app this cabinet opens on: WhatsApp's own Conversations app, which Cabinet writes.
app: whatsapp/all-conversations

# What this cabinet connects to. References only: accounts, numbers and keys never appear here.
connectors:
  - id: whatsapp
    need: needs
    access: [read, send]
    why: Reads the chats you pick and drafts replies you approve.
    hero: true
  - id: google-calendar
    need: better-with
    access: [change]
    why: Puts plans from your chats on your calendar when you ask.

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: "Who's waiting on me?"
    connector: whatsapp
  - text: "Which quotes are still open?"
    connector: whatsapp
  - text: "What appointments did I set this week?"
    connector: whatsapp
  - text: "Who hasn't heard back from me in a day?"
    connector: whatsapp
  - text: "List every customer who asked for a quote."
    connector: whatsapp
  - text: "What did I promise customers this week?"
    connector: whatsapp
  - text: "Build my customer list from my chats."
    connector: whatsapp
  - text: "Follow up on quotes with no answer. Show me the drafts first."
    connector: whatsapp
  - text: "Did any customer complain this week?"
    connector: whatsapp
  - text: "Which customers haven't written in two months?"
    connector: whatsapp
  - text: "What did I agree with the plumber?"
    connector: whatsapp
  - text: "Find the address a customer sent me last month."
    connector: whatsapp
  - text: "Who wrote to me from a number I haven't saved?"
    connector: whatsapp
  - text: "From now on, skip the family group."
    connector: whatsapp
  - text: "Put the appointments from my chats on my calendar."
    connector: google-calendar
