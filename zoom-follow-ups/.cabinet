schemaVersion: 1
id: zoom-follow-ups-root
name: Zoom Follow-ups
kind: root
version: 0.1.0
description: After each meeting, the next steps become tasks and a short note goes to everyone who was there.
entry: index.md
domain: Operations

# Cabinet draws this cabinet's home itself: the meetings waiting for a follow-up, the notes
# written so far, Make tasks from next steps, and an ask box.
connectors:
  - id: zoom
    need: needs
    access: [read]
    why: Reads the meetings and summaries Cabinet keeps from your Zoom. Nothing is sent.

prompts:
  - text: Which meetings still need a follow-up?
    connector: zoom
  - text: Draft the follow-up note for my last meeting
    connector: zoom
  - text: Make tasks from the next steps of my last meeting
    connector: zoom
  - text: What did I promise people this week?
    connector: zoom
  - text: Who is waiting on me after yesterday's meetings?
    connector: zoom
