schemaVersion: 1
id: telegram-digest-root
name: Telegram Digest
kind: root
version: 0.2.0
description: Telegram shows every chat. This shows the few that need you, what you promised, and what you can safely skip.
entry: index.md
domain: Operations
app: catch-up
connectors:
  - id: telegram
    need: needs
    access: [read]
    why: Reads the chats and groups your bot is in each morning. Nothing is sent.
    hero: true
prompts:
  - text: Who is waiting on a reply from me on Telegram?
    connector: telegram
  - text: What did I promise people this week?
    connector: telegram
  - text: Catch me up on my busiest group
    connector: telegram
  - text: What did my groups decide yesterday?
    connector: telegram
  - text: Did anyone send me a link or a file today?
    connector: telegram
  - text: Write a reply to everyone waiting more than a day
    connector: telegram
  - text: Which chats are loud but never need me?
    connector: telegram
  - text: Which posts in my channels are worth reading?
    connector: telegram
