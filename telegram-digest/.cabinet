schemaVersion: 1
id: telegram-digest-root
name: Telegram Digest
kind: root
version: 0.1.1
description: Every morning, what came in on Telegram overnight and which of it wants you.
entry: index.md
domain: Operations
connectors:
  - id: telegram
    need: needs
    access: [read]
    why: Reads the chats that moved overnight.
    hero: true
prompts:
  - text: Who is waiting on a reply from me on Telegram?
    connector: telegram
  - text: What came in overnight that needs me?
    connector: telegram
  - text: Summarize yesterday's group chat
    connector: telegram
  - text: Did anyone send me a link or a file today?
    connector: telegram
