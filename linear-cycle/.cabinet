schemaVersion: 1
id: linear-cycle-root
name: Linear Cycle
kind: root
version: 0.1.1
description: Every morning, the Linear issues that are on you this cycle.
entry: index.md
domain: Operations
connectors:
  - id: linear
    need: needs
    access: [read]
    why: Reads your issues in the current cycle.
    hero: true
prompts:
  - text: Which issues are on me this cycle?
    connector: linear
  - text: Is anyone blocked waiting on my issues?
    connector: linear
  - text: What's urgent in the current cycle?
    connector: linear
  - text: How many of my cycle issues are still open?
    connector: linear
  - text: When does this cycle end?
    connector: linear
