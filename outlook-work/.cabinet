schemaVersion: 1
id: outlook-work-root
name: Outlook for Work
kind: root
version: 0.2.0
description: Your workday from Outlook on one board. Meetings with what to know before each, who is waiting on you, and what you promised.
entry: index.md
domain: Operations
app: my-workday

connectors:
  - id: outlook
    need: needs
    access: [read, draft]
    why: Reads your work mail each morning. Drafts wait in Outlook, nothing is sent.
  - id: outlook-calendar
    need: better-with
    access: [read]
    why: Reads today's meetings so the replies fit around them.

prompts:
  - text: "Get me ready for my next meeting"
    connector: outlook-calendar
  - text: "What does my manager need from me?"
    connector: outlook
  - text: "Who has been waiting longest for me?"
    connector: outlook
  - text: "Find me two hours of focus time this week"
    connector: outlook-calendar
  - text: "Draft a reply to everyone waiting more than 2 days"
    connector: outlook
  - text: "What did I promise people this week?"
    connector: outlook
  - text: "Write my weekly status update"
    connector: outlook
  - text: "Which meetings tomorrow have no agenda?"
    connector: outlook-calendar
