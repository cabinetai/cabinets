schemaVersion: 1
id: microsoft-365-brief-root
name: Microsoft 365 Brief
kind: root
version: 0.1.1
description: Every morning, your whole day across Microsoft 365 on one page.
entry: index.md
domain: Operations
connectors:
  - id: microsoft-365
    need: needs
    access: [read]
    why: Reads today's meetings, overnight mail, messages and changed files.
    hero: true
prompts:
  - text: What's on my calendar today?
    connector: microsoft-365
  - text: Who is waiting on a reply from me in Outlook?
    connector: microsoft-365
  - text: What did people ask me for in Teams yesterday?
    connector: microsoft-365
  - text: Which shared files changed since yesterday?
    connector: microsoft-365
  - text: Do I get a break between meetings today?
    connector: microsoft-365
