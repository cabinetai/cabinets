schemaVersion: 1
id: notion-project-sync-root
name: Project Sync
kind: root
version: 0.1.0
description: Your Notion task databases on one page. What is overdue, what is due this week, who carries what, and what moved since yesterday.
entry: index.md
domain: Operations

# Cabinet draws this cabinet's home itself from the Notion copy: open, due and overdue tasks,
# tasks by status and by owner, what moved, the databases, the latest brief, tools and an ask box.
connectors:
  - id: notion
    need: needs
    access: [read, change]
    why: Reads your Notion task databases; updates a status only when you ask.
    usedBy: [jobs/morning-projects]

prompts:
  - text: What is overdue in our Notion projects?
    connector: notion
  - text: What is due this week?
    connector: notion
  - text: Give me a status update for this week
    connector: notion
  - text: Who has the most open tasks?
    connector: notion
  - text: What moved since yesterday?
    connector: notion
  - text: Which tasks are blocked?
    connector: notion
  - text: Mark the launch checklist task as done
    connector: notion
  - text: Which tasks have no owner?
    connector: notion
