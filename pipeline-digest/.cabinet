schemaVersion: 1
id: pipeline-digest-root
name: Pipeline Digest
kind: root
version: 0.1.0
description: Every morning, the deals that moved in Salesforce, what closes this week, what went quiet, and what is due today.
entry: index.md
domain: Sales
app: your-pipeline
connectors:
  - id: salesforce
    need: needs
    access: [read, create, change]
    why: Reads your deals, tasks and leads. Adds a task or note only when you say yes in the chat.
    hero: true
prompts:
  - text: Which deals should I work on today?
    connector: salesforce
  - text: What changed in my pipeline this week?
    connector: salesforce
  - text: What closes this month, and what is at risk?
    connector: salesforce
  - text: Which deals have gone quiet?
    connector: salesforce
  - text: Draft a follow-up for my oldest quiet deal
    connector: salesforce
  - text: Plan my calls for today
    connector: salesforce
  - text: Write a weekly pipeline summary for my team
    connector: salesforce
  - text: Where do our best leads come from?
    connector: salesforce
