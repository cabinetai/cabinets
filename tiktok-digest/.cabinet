schemaVersion: 1
id: tiktok-digest-root
name: TikTok Digest
kind: root
version: 0.1.0
description: Every morning, how your recent TikTok videos did, which one moved most, and three ideas for the next one.
entry: index.md
domain: Media
app: your-tiktok
connectors:
  - id: tiktok
    need: needs
    access: [read]
    why: Reads your account's counts and your videos' views, likes, comments and shares.
    hero: true
prompts:
  - text: How did my latest TikTok do?
    connector: tiktok
  - text: Which of my videos moved most this week?
    connector: tiktok
  - text: What do my best videos have in common?
    connector: tiktok
  - text: Give me three ideas for my next video
    connector: tiktok
  - text: Which day of the week do my videos do best?
    connector: tiktok
  - text: Write a better caption for my quietest video
    connector: tiktok
  - text: Compare this month with last month
    connector: tiktok
  - text: Plan a follow-up to my best video
    connector: tiktok
