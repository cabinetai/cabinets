schemaVersion: 1
id: shorts-factory-root
name: Shorts Factory
kind: root
version: 0.1.4
description: Short vertical videos that market your business. Pick an idea, get the script, captions and the finished video, ready for TikTok, Reels and Shorts.
entry: index.md
domain: Media
app: studio
connectors:
  - id: ai-images
    need: needs
    access: [create]
    why: Makes a picture for each scene of your video.
    usedBy: [jobs/make-video]
  - id: ai-voice
    need: needs
    access: [create]
    why: Reads each scene of your video aloud.
    usedBy: [jobs/make-video]
  - id: ai-video
    need: better-with
    access: [create]
    why: Brings scene pictures to life when you choose moving scenes.
    usedBy: [jobs/make-video]
