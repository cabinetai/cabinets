schemaVersion: 1
id: snowflake-brief-root
name: Snowflake Brief
kind: root
version: 0.1.1
description: Every Monday, the numbers out of your warehouse, in plain words.
entry: index.md
domain: Marketing
connectors:
  - id: snowflake
    need: needs
    access: [read]
    why: Reads last week's metrics out of your warehouse.
    hero: true
prompts:
  - text: How did revenue move against last week?
    connector: snowflake
  - text: Which metric changed the most last week?
    connector: snowflake
  - text: How many new signups did we get last week?
    connector: snowflake
  - text: Is anything in last week's numbers worth a look?
    connector: snowflake
