schemaVersion: 1
id: money-morning-root
name: Money Morning
kind: root
version: 0.1.1
description: Yesterday's money in plain words — what came in, what failed, who left.
entry: index.md
domain: Operations
connectors:
  - id: stripe
    need: needs
    access: [read]
    why: Reads yesterday's charges, refunds, disputes and new customers.
    hero: true
prompts:
  - text: How much came in yesterday?
    connector: stripe
  - text: Did any card payments fail this week?
    connector: stripe
  - text: Who cancelled their subscription this month?
    connector: stripe
  - text: Are there any open disputes I need to answer?
    connector: stripe
  - text: What were my biggest payments last week?
    connector: stripe
