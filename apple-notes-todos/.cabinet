schemaVersion: 1
id: apple-notes-todos-root
name: Notes To-Dos
kind: root
version: 0.1.0
description: Every to-do you wrote down in Apple Notes, gathered on one page, the newest first.
entry: index.md
domain: Operations
app: your-todos
connectors:
  - id: apple-notes
    need: needs
    access: [read]
    why: Reads the notes you imported from Apple Notes to find what you still have to do.
    hero: true
prompts:
  - text: What did I write down to do this week?
    connector: apple-notes
  - text: What did I promise someone in my notes?
    connector: apple-notes
  - text: Which to-dos have a date coming up?
    connector: apple-notes
  - text: Which of my to-dos are the oldest?
    connector: apple-notes
  - text: Make me a short plan for today from my notes
    connector: apple-notes
  - text: Find everything I wrote about the move
    connector: apple-notes
