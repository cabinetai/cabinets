schemaVersion: 1
id: google-drive-my-documents-root
name: My Documents
kind: root
version: 0.1.0
description: Receipts, letters, contracts and forms in one Drive folder, filed and findable.
entry: index.md
domain: Lifestyle
connectors:
  - id: google-drive
    need: needs
    access:
      - read
    why: Reads your documents folder so you can ask where something is.
    usedBy:
      - jobs/file-new-documents
      - jobs/monthly-paperwork-check
prompts:
  - text: Where is my lease?
    connector: google-drive
  - text: Find last year's tax return.
    connector: google-drive
  - text: What did the insurance letter actually say?
    connector: google-drive
  - text: Do I have a receipt for the laptop?
    connector: google-drive
  - text: What expires in the next three months?
    connector: google-drive
  - text: How much did I pay the plumber?
    connector: google-drive
  - text: Which documents have no date on them?
    connector: google-drive
  - text: Find everything about the car.
    connector: google-drive
  - text: What did I sign in March?
    connector: google-drive
