schemaVersion: 1
id: sharepoint-week-root
name: SharePoint Week
kind: root
version: 0.2.0
description: Every Monday, what your team changed in SharePoint, from price lists to contracts, by person and folder.
entry: index.md
domain: Operations
app: week-in-files
connectors:
  - id: sharepoint
    need: needs
    access: [read]
    why: Reads which files your team changed in SharePoint in the last 7 days.
prompts:
  - text: What changed in our price list?
    connector: sharepoint
  - text: Which contracts were edited this month?
    connector: sharepoint
  - text: List every new quote and invoice this week
    connector: sharepoint
  - text: What should I look at first?
    connector: sharepoint
  - text: Find files nobody touched in a year
    connector: sharepoint
