schemaVersion: 1
id: sharepoint-bid-room-root
name: Bid Room
kind: root
version: 0.1.0
description: One page that says where the bid stands. What is written, what is missing, what is due next.
entry: index.md
domain: Professional Services
connectors:
  - id: sharepoint
    need: needs
    access:
      - read
    why: Reads the bid folder your team keeps in SharePoint.
prompts:
  - text: What is still missing from the bid?
    connector: sharepoint
  - text: Which requirements have we not answered yet?
    connector: sharepoint
  - text: What is due in the next three days?
    connector: sharepoint
