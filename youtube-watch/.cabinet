schemaVersion: 1
id: youtube-watch-root
name: YouTube Watch
kind: root
version: 0.1.1
description: Every morning, what on your YouTube channel needs a look, ranked, each with a link and a next step.
entry: index.md
domain: Media
app: board
connectors:
  - id: youtube
    need: needs
    access: [read, post]
    why: Reads your videos and comments to spot trouble, and replies only when you ask in the chat.
prompts:
  - text: What on my channel needs my attention?
    connector: youtube
  - text: Are there spam or scam comments I should remove?
    connector: youtube
  - text: Which video is doing worse than usual, and why?
    connector: youtube
  - text: Is anyone angry in my comments?
    connector: youtube
  - text: Which questions have waited longest for an answer?
    connector: youtube
  - text: Who asked about a sponsorship or a collab?
    connector: youtube
  - text: Is anyone saying something false about me?
    connector: youtube
