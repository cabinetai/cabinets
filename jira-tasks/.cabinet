schemaVersion: 1
id: jira-tasks-root
name: Jira Tasks
kind: root
version: 0.1.1
description: Every morning, the Jira tickets that are actually on you today.
entry: index.md
domain: Operations
connectors:
  - id: jira
    need: needs
    access: [read]
    why: Reads the tickets assigned to you.
    hero: true
prompts:
  - text: Which tickets are on me today?
    connector: jira
  - text: Is anyone blocked waiting on my tickets?
    connector: jira
  - text: What's in progress on my board?
    connector: jira
  - text: Which of my tickets have had no update this week?
    connector: jira
