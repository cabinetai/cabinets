schemaVersion: 1
id: instagram-digest-root
name: Instagram Digest
kind: root
version: 0.1.0
description: Every morning, the questions waiting under your Instagram posts, what got saved and shared, and what to post next.
entry: index.md
domain: Media
app: your-instagram
connectors:
  - id: instagram
    need: needs
    access: [read, post, change]
    why: Reads your posts, numbers and comments. Replies or hides only after your yes in a chat.
    hero: true
prompts:
  - text: Which comments are waiting for my answer?
    connector: instagram
  - text: What do people keep asking me?
    connector: instagram
  - text: Which of my posts got saved the most this month?
    connector: instagram
  - text: Do my reels or my carousels get shared more?
    connector: instagram
  - text: How did my latest reel do?
    connector: instagram
  - text: Draft replies to the questions under my latest post
    connector: instagram
  - text: Draft a caption with hashtags for my next post
    connector: instagram
  - text: Bring in my Instagram export
