schemaVersion: 1
id: discord-digest-root
name: Discord Digest
kind: root
version: 0.3.0
description: Every morning, the questions nobody answered in your Discord server and what moved in each channel.
entry: index.md
domain: Operations
app: your-discord
connectors:
  - id: discord
    need: needs
    access: [read, post]
    why: Reads the channels you choose. Posts only after your yes, where you allow it.
    hero: true
prompts:
  - text: Which questions are still unanswered?
    connector: discord
  - text: What did people ask for help with this week?
    connector: discord
  - text: Which thread got heated?
    connector: discord
  - text: Summarize the announcements channel from this week
    connector: discord
