schemaVersion: 1
id: discord-digest-root
name: Discord Digest
kind: root
version: 0.2.0
description: Every morning, what moved in your Discord server, the channels worth your time first.
entry: index.md
domain: Operations
app: your-discord
connectors:
  - id: discord
    need: needs
    access: [read]
    why: Reads the last day in the server channels you allow Cabinet to read.
    hero: true
prompts:
  - text: What happened in the server yesterday?
    connector: discord
  - text: Which channels are worth my time today?
    connector: discord
  - text: Did anyone ask for help in the support channel?
    connector: discord
  - text: Summarize the announcements channel from this week
    connector: discord
