schemaVersion: 1
id: discord-digest-root
name: Discord Digest
kind: root
version: 0.1.1
description: Every morning, what was worth reading in your Discord server over the last 24 hours.
entry: index.md
domain: Operations
connectors:
  - id: discord
    need: needs
    access: [read]
    why: Reads the last day in the server channels the bot can see.
    hero: true
prompts:
  - text: What happened in the server yesterday?
    connector: discord
  - text: Which channels are worth my time today?
    connector: discord
  - text: Did anyone ask for help in the support channel?
    connector: discord
  - text: Summarize the announcements channel from this week
    connector: discord
