schemaVersion: 1
id: figma-week-root
name: Figma Week
kind: root
version: 0.1.1
description: Every Monday, what changed in your Figma files last week.
entry: index.md
domain: Operations
connectors:
  - id: figma
    need: needs
    access: [read]
    why: Reads last week's changes in the design files you can open.
    hero: true
prompts:
  - text: Which components changed last week?
    connector: figma
  - text: What changed in the design system file?
    connector: figma
  - text: Did anyone change the colour variables?
    connector: figma
  - text: Which Figma files were edited this week?
    connector: figma
