schemaVersion: 1
id: monday-tasks-root
name: monday.com Tasks
kind: root
version: 0.1.1
description: Every morning, the monday.com items that are actually on you today.
entry: index.md
domain: Operations
connectors:
  - id: monday
    need: needs
    access: [read]
    why: Reads the items assigned to you across your boards.
    hero: true
prompts:
  - text: Which items are on me today?
    connector: monday
  - text: Is anyone stuck waiting on me?
    connector: monday
  - text: Which of my items are marked Stuck?
    connector: monday
  - text: Which of my items are due this week?
    connector: monday
