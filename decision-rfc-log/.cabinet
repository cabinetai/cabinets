schemaVersion: 1
id: decision-rfc-log-root
name: Decision & RFC Log
kind: root
version: 0.1.1
description: "React 🧠 or 📝 on a Slack or Discord thread and the decision lands in one table: what was decided, who decided, when, and a link back."
entry: index.md
domain: Software
app: decisions
connectors:
  - id: slack
    need: better-with
    access: [read, post]
    why: Reads Slack threads marked 🧠 or 📝 to log decisions, and posts only when you ask.
  - id: discord
    need: better-with
    access: [read, post]
    why: Reads Discord threads marked 🧠 or 📝 to log decisions, and posts only when you ask.
prompts:
  - text: What did we decide this week?
  - text: Which RFCs are still open?
  - text: Who decided the most this month?
  - text: What changed since last week?
  - text: Find every decision about the release
