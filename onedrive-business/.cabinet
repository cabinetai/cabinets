schemaVersion: 1
id: onedrive-business-root
name: OneDrive for Business
kind: root
version: 0.1.0
description: A file room for your work OneDrive. Comments waiting on you, files clients sent, the latest version, and contract dates.
entry: index.md
domain: Operations
app: file-room

connectors:
  - id: onedrive
    need: needs
    access: [read]
    why: Reads your OneDrive each morning to keep the file room current. It never changes a file.

prompts:
  - text: "Which comments are waiting on me?"
    connector: onedrive
  - text: "What did clients share with me this week?"
    connector: onedrive
  - text: "Where is the latest version of the price list?"
    connector: onedrive
  - text: "Which contracts end or renew in the next 90 days?"
    connector: onedrive
  - text: "List every contract and when it ends"
    connector: onedrive
  - text: "Which of my files can anyone with the link open?"
    connector: onedrive
  - text: "What changed in OneDrive this week?"
    connector: onedrive
  - text: "Write one page per client from their folder"
    connector: onedrive
  - text: "Pick the 10 files a new hire should read first"
    connector: onedrive
  - text: "What takes up the most space in my OneDrive?"
    connector: onedrive
