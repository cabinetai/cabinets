schemaVersion: 1
id: video-library-root
name: Video Library
kind: root
version: 0.1.4
description: Save videos from YouTube, Instagram, TikTok, X, LinkedIn and Facebook into your cabinet, then read, search and ask about them.
entry: index.md
domain: Media
app: library
connectors:
  - id: youtube
    need: better-with
    access: [read]
    why: Not needed for public links; connected, it can also find your own uploads.
  - id: tiktok
    need: better-with
    access: [read]
    why: Not needed for public links; connected, it can also find your own videos.
  - id: instagram
    need: better-with
    access: [read]
    why: Not needed for public links; connected, it can also find your own posts.
prompts:
  - text: Save this TikTok and tell me what it says
    connector: tiktok
  - text: Save the transcript of a YouTube video and summarize it
  - text: Save a LinkedIn or Instagram video and its post text
  - text: What are the key points of my latest saved video?
  - text: Find the best 30 second clips in my videos
  - text: Which of my saved videos talks about pricing?
  - text: Show me all my videos about baking
  - text: Bring in my TikTok favorites
  - text: Write study notes from my latest video
  - text: Quote the strongest line from each video I saved
  - text: Compare the two videos I saved last
  - text: How much space do my saved videos take?
