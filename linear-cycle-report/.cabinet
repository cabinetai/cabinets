schemaVersion: 1
id: linear-cycle-report-root
name: Cycle Report
kind: root
version: 0.1.2
description: Every Friday, how each team's Linear cycle is going. Done against total, scope added, what is at risk, and how the projects stand.
entry: index.md
domain: Operations

# The app this cabinet opens on.
app: cycle-report

# What this cabinet connects to. References only: accounts, workspaces and keys never appear here.
connectors:
  - id: linear
    need: needs
    access: [read]
    why: Reads your teams' cycles, issues and project updates to write the weekly report.

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: How is the cycle going?
    connector: linear
  - text: What will slip this cycle?
    connector: linear
  - text: Summarise the project most at risk
    connector: linear
  - text: How much scope was added this cycle?
    connector: linear
  - text: Draft the retro for the cycle that just ended
    connector: linear
  - text: Which projects have no update this week?
    connector: linear
  - text: Write a cycle update I can post to the team
    connector: linear
