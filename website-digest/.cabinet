schemaVersion: 1
id: website-digest-root
name: Website Digest
kind: root
version: 0.1.0
description: Every morning, how your website did this week, where visitors came from, and what changed.
entry: index.md
domain: Media
app: your-website
connectors:
  - id: google-analytics
    need: needs
    access: [read]
    why: Reads your website's visitors, pages, sources and key events. Never changes a setting.
    hero: true
prompts:
  - text: How did my website do this week?
    connector: google-analytics
  - text: Where do my visitors come from?
    connector: google-analytics
  - text: Which pages do people read most?
    connector: google-analytics
  - text: Why did my visitors go up or down?
    connector: google-analytics
  - text: How many people are on my site right now?
    connector: google-analytics
  - text: Which pages lead to the most key events?
    connector: google-analytics
  - text: Write a short summary of last month to share with my team
    connector: google-analytics
  - text: Which pages do people leave quickly?
    connector: google-analytics
