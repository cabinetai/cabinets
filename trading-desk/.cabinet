schemaVersion: 1
id: trading-desk-root
name: Trading Desk
kind: root
version: 0.1.0
description: A desk for your trading. Real charts, alerts on your own rules, a plan and a size for every trade, and a journal that shows what works for you.
entry: index.md
domain: Finance

# The app this cabinet opens on. Older Cabinets open on index.md.
app: desk

# What this cabinet connects to. The desk itself runs without any of it: only the
# Robinhood routines named below wait for Robinhood.
# References only: accounts, addresses and keys never appear here.
connectors:
  - id: robinhood
    need: needs
    access: [read, change, create]
    why: Shows your real account, scans the market, and places an order only when you say yes.
    usedBy: [jobs/sync-robinhood, jobs/market-scan, jobs/holdings-checkup, jobs/set-price-alerts, jobs/month-in-money]
  - id: google-calendar
    need: better-with
    access: [change]
    why: Puts earnings dates and big economic news on your calendar when you ask.
    usedBy: [agents/analyst]

# Things to try in this cabinet: at most 16, each at most 80 characters.
prompts:
  - text: "What should I watch today, and why?"
  - text: "Explain today's market like I am new to this."
  - text: "Scan the whole market and show me what stands out today."
    connector: robinhood
  - text: "Which of my holdings needs my attention this week?"
    connector: robinhood
  - text: "Set a phone alert in Robinhood for every stop and target I have."
    connector: robinhood
  - text: "Where did my money go this month?"
    connector: robinhood
  - text: "Send my newest plan to Robinhood. Show me the order before you place it."
    connector: robinhood
  - text: "Add PLTR and COIN to my list and tell me what their charts are doing."
  - text: "Find three swing ideas on my list and plan each one."
  - text: "Check my plan for TSLA before I take it."
  - text: "Import my trades. I will paste my broker's export."
  - text: "What is my most expensive mistake this month?"
  - text: "Check this post from X against the real numbers. I will paste it."
  - text: "Which of my alert rules has worked on my list, and which has not?"
  - text: "Put this week's earnings and economic news on my calendar."
    connector: google-calendar
