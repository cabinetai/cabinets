schemaVersion: 1
id: google-drive-personal-root
name: Drive for Personal
kind: root
version: 0.1.0
description: Your own Drive, sorted. Where your passport and insurance are, what expires soon, what family shared, and what fills it.
entry: index.md
domain: Lifestyle
app: my-files

connectors:
  - id: google-drive
    need: needs
    access: [read]
    why: Reads your Drive each morning to keep your papers findable. It never changes a file.
    hero: true

prompts:
  - text: "Where is my passport scan?"
    connector: google-drive
  - text: "When does my car insurance renew?"
    connector: google-drive
  - text: "What expires in the next 6 months?"
    connector: google-drive
  - text: "What did my family share with me this week?"
    connector: google-drive
  - text: "Which of my files can anyone with the link open?"
    connector: google-drive
  - text: "What takes up the most space in my Drive?"
    connector: google-drive
  - text: "Find this year's tax papers"
    connector: google-drive
  - text: "Give my scans real names"
    connector: google-drive
  - text: "Write a where-is-everything page for my family"
    connector: google-drive
  - text: "Find the fridge warranty"
    connector: google-drive
