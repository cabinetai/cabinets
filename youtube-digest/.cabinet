schemaVersion: 1
id: youtube-digest-root
name: YouTube Digest
kind: root
version: 0.1.0
description: Every morning, how your YouTube channel did and the comments waiting for you, each with a reply ready to send.
entry: index.md
domain: Media
app: channel

connectors:
  - id: youtube
    need: needs
    access: [read, post]
    why: Reads your videos, numbers and comments. A reply goes out only after you approve it.
    hero: true

prompts:
  - text: Which comments are waiting for my answer?
    connector: youtube
  - text: How did my latest video do?
    connector: youtube
  - text: What do viewers keep asking me?
    connector: youtube
  - text: Which video did best this month, and why?
    connector: youtube
  - text: Where do my views come from?
    connector: youtube
  - text: Give me three ideas for my next video
    connector: youtube
  - text: Draft replies to the questions under my latest video
    connector: youtube
  - text: Suggest a better title for my quietest video
    connector: youtube
