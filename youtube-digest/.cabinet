schemaVersion: 1
id: youtube-digest-root
name: YouTube Digest
kind: root
version: 0.1.0
description: Every morning, how your YouTube channel did, the comments waiting for you, and what viewers keep asking.
entry: index.md
domain: Media
app: your-youtube
connectors:
  - id: youtube
    need: needs
    access: [read, post]
    why: Reads your videos and comments, and replies only when you ask in the chat.
    hero: true
prompts:
  - text: Which comments are waiting for my answer?
    connector: youtube
  - text: How did my latest video do?
    connector: youtube
  - text: What do viewers keep asking me?
    connector: youtube
  - text: Give me three ideas for my next video
    connector: youtube
  - text: Which video did best this week?
    connector: youtube
  - text: Summarize what people said about my latest video
    connector: youtube
  - text: Draft replies to the questions under my latest video
    connector: youtube
  - text: Suggest a better title for my quietest video
    connector: youtube
